.page-shell {
  min-height: 100vh;
  padding: 28rpx 24rpx 64rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(98, 191, 255, 0.28), transparent 30%),
    linear-gradient(180deg, #eef6ff 0%, #f8fbff 40%, #f3f6fb 100%);
}

.hero-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(14, 47, 86, 0.94);
  box-shadow: 0 18rpx 36rpx rgba(15, 23, 42, 0.14);
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-subtitle {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.72);
}

.hero-badge {
  max-width: 240rpx;
  padding: 16rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-badge-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.64);
}

.hero-badge-value {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #ffffff;
  word-break: break-all;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  gap: 14rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12rpx 32rpx rgba(16, 42, 67, 0.08);
}

.state-text {
  font-size: 30rpx;
  color: #243b53;
}

.state-subtext {
  font-size: 24rpx;
  color: #829ab1;
}

.chat-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.chat-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.chat-row-left {
  justify-content: flex-start;
}

.chat-row-right {
  justify-content: flex-start;
  flex-direction: row-reverse;
}

.chat-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 10rpx 20rpx rgba(15, 23, 42, 0.12);
}

.chat-avatar-left {
  background: linear-gradient(135deg, #12355b 0%, #2d6cdf 100%);
}

.chat-avatar-right {
  background: linear-gradient(135deg, #ff8f3d 0%, #ff5b4d 100%);
}

.chat-avatar-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.chat-bubble-wrap {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  max-width: calc(100% - 80rpx);
}

.chat-bubble-wrap-right {
  align-items: flex-end;
}

.chat-bubble-wrap-left {
  align-items: flex-start;
}

.chat-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chat-meta-right {
  justify-content: flex-end;
}

.chat-role {
  font-size: 22rpx;
  font-weight: 600;
  color: #486581;
}

.chat-bubble {
  display: flex;
  flex-direction: column;
  max-width: 82%;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 26rpx rgba(15, 23, 42, 0.08);
}

.chat-bubble-left {
  border-top-left-radius: 10rpx;
  background: #ffffff;
}

.chat-bubble-right {
  border-top-right-radius: 10rpx;
  background: linear-gradient(135deg, #0b69ff 0%, #2aa9ff 100%);
}

.chat-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #102a43;
  white-space: pre-wrap;
  word-break: break-word;
}

.chat-bubble-right .chat-text {
  color: #ffffff;
}

.chat-time {
  font-size: 20rpx;
  color: #7b8794;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
}

.loading-more-text {
  font-size: 22rpx;
  color: #829ab1;
}