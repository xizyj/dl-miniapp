.page-shell {
  min-height: 100vh;
  padding: 32rpx 20rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #3f82e8 0%, #68a0f2 48%, #c7daf7 100%);
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.page-header-spacer {
  width: 64rpx;
  height: 64rpx;
}

.page-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.page-header-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(24, 86, 185, 0.45);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.08);
}

.page-header-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.header-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
}

.header-dot-active {
  width: 14rpx;
  height: 14rpx;
  background: #ffffff;
}

.header-divider {
  width: 2rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.22);
}

.header-short-line {
  width: 34rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
}

.header-ring {
  width: 30rpx;
  height: 30rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-sizing: border-box;
}

.search-panel {
  margin-bottom: 42rpx;
  padding: 30rpx;
  border-radius: 34rpx;
  background: rgba(213, 228, 255, 0.85);
  box-shadow: 0 12rpx 32rpx rgba(27, 77, 173, 0.14);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.search-input {
  flex: 1;
  height: 94rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 0 0 3rpx rgba(228, 233, 244, 0.9);
  font-size: 28rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.search-button {
  width: 132rpx;
  min-width: 132rpx;
  margin: 0;
  border: none;
  border-radius: 14rpx;
  background: linear-gradient(180deg, #2d8eff 0%, #0d57e8 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 94rpx;
  box-shadow: 0 10rpx 24rpx rgba(13, 87, 232, 0.28);
}

.search-button::after {
  border: none;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 32rpx;
  border-radius: 54rpx;
  background: rgba(232, 241, 255, 0.86);
  box-shadow: 0 18rpx 40rpx rgba(27, 77, 173, 0.12);
}

.state-text {
  font-size: 30rpx;
  color: #204b99;
}

.state-subtext {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6a8fc8;
}

.swiper-zone {
  overflow: hidden;
}

.model-swiper {
  height: 1040rpx;
}

.model-item-shell {
  height: 100%;
  padding: 12rpx 10rpx 0;
  box-sizing: border-box;
}

.model-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  padding: 34rpx 42rpx 48rpx;
  border-radius: 60rpx;
  background: linear-gradient(180deg, rgba(226, 236, 255, 0.98) 0%, rgba(240, 246, 255, 0.98) 100%);
  box-shadow: 0 22rpx 52rpx rgba(27, 77, 173, 0.12);
  box-sizing: border-box;
}

.model-card-top {
  display: flex;
  justify-content: flex-end;
  width: 100%;
}

.model-status {
  padding: 12rpx 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 8rpx 18rpx rgba(83, 128, 203, 0.12);
  font-size: 24rpx;
  color: #4b94ff;
}

.model-art {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 360rpx;
  margin-top: 30rpx;
}

.model-art-orb {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.92), rgba(157, 193, 255, 0.9) 65%, rgba(123, 169, 247, 0.3) 100%);
  filter: blur(2rpx);
}

.model-art-image {
  position: relative;
  z-index: 1;
  width: 220rpx;
  height: 220rpx;
}

.model-name {
  margin-top: 14rpx;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #1e73f0;
  text-align: center;
}

.model-code {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #7f98c6;
  text-align: center;
  word-break: break-all;
}

.model-desc {
  margin-top: 42rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1e1f24;
  text-align: center;
  word-break: break-word;
}

.model-meta {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #86a0cd;
}

.bind-button {
  width: 100%;
  margin: auto 0 0;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2d95ff 0%, #0b5ff4 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 90rpx;
  box-shadow: 0 16rpx 36rpx rgba(11, 95, 244, 0.2);
}

.bind-button::after {
  border: none;
}

.swiper-footer {
  padding-top: 22rpx;
}

.swipe-hint {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  text-align: center;
}