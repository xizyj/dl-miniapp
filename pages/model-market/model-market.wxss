.page-shell {
  min-height: 100vh;
  padding: 24rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(16, 42, 67, 0.08);
}

.search-card {
  margin-bottom: 24rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f3f7fb;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-button {
  min-width: 144rpx;
  margin: 0;
  border: none;
  border-radius: 18rpx;
  background: #102a43;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 84rpx;
}

.search-button::after {
  border: none;
}

.search-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #7b8794;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  gap: 12rpx;
}

.state-text {
  font-size: 30rpx;
  color: #243b53;
}

.state-subtext {
  font-size: 24rpx;
  color: #829ab1;
}

.list-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.model-swiper {
  height: 600rpx;
}

.model-item-shell {
  height: 100%;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.model-item {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 28rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #fbfdff 0%, #f3f7fb 100%);
  box-sizing: border-box;
}

.model-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.model-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #102a43;
}

.model-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef4fa;
  font-size: 22rpx;
  color: #486581;
}

.model-code {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #486581;
}

.model-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #243b53;
}

.model-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #829ab1;
}

.bind-button {
  margin-top: auto;
  border: none;
  border-radius: 18rpx;
  background: #102a43;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 80rpx;
}

.bind-button::after {
  border: none;
}

.swipe-hint {
  display: block;
  font-size: 22rpx;
  color: #829ab1;
  text-align: center;
}