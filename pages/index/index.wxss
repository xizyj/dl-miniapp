.hero {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #f5efe6 0%, #ead8c0 100%);
}

.eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #8a5a2b;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #1f2933;
}

.subtitle {
  font-size: 28rpx;
  line-height: 1.7;
  color: #52606d;
}

.panel {
  margin-top: 28rpx;
  padding: 32rpx;
}

.panel-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #102a43;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(16, 42, 67, 0.08);
}

.row:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: #486581;
}

.value {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2933;
  text-align: right;
}

.check-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: #d9822b;
  flex-shrink: 0;
}

.check-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #334e68;
}