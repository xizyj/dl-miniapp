<view class="page">
  <view class="weui-form">
    <view class="weui-form__text-area">
      <view class="weui-form__title">蓝牙配网{{version}}</view>
      <view class="weui-form__desc">设计理念：简单/快速上手</view>
    </view>
    <view class="weui-form__control-area">
      <view class="weui-cells__group weui-cells__group_form">
        <view class="weui-cells__title">当前手机 Wi-Fi：{{ssid || '未获取到'}}</view>
        <view class="weui-cells weui-cells_form">
          <view class="weui-cell">
            <view class="weui-cell__bd">
              <text>{{wifiLoading ? '正在读取当前 Wi-Fi...' : (ssid || '请确认手机已连接 Wi-Fi，并点击刷新')}}</text>
            </view>
            <button size="mini" bindtap="refreshCurrentWifi">刷新</button>
          </view>
          <view class="weui-cell">
            <view class="weui-cell__hd"><label class="weui-label">密码：</label></view>
            <view class="weui-cell__bd">
              <input class="weui-input" value="{{password}}" bindinput="bindPasswordInput" type="text" placeholder="在此输入路由器密码" />
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="weui-form__tips-area">
      <label for="weuiAgree" class="weui-agree">
        <input id="weuiAgree" type="checkbox" class="weui-agree__checkbox" /><span class="weui-agree__text">{{connected?"蓝牙已连接":"蓝牙已断开"}}
        </span>
      </label>
    </view>
    <view class="weui-form__opr-area">
      <button bindtap="OnClickStart" disabled="{{!isInitOK || wifiLoading}}" type="primary">{{isInitOK ? '开始配网' : '设备初始化失败'}}</button>
    </view>

  </view>
</view>