page {
  background-color: #f8f8f8;
}
.container {
  padding: 0 30rpx 0 30rpx;
  align-items: center;
}

.search-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 690rpx;
  padding: 24rpx 0 16rpx;
  box-sizing: border-box;
}

.search-status {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #666;
}

.search-action-button {
  width: 200rpx;
  min-width: 200rpx;
  margin: 0 0 0 24rpx;
  padding: 0 12rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.list-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 10px 0 10px 0;
  box-sizing: border-box;
  border: 1px solid #000;
  border-style: none none solid none;
  border-bottom-color: lightgray;
}
.list-item:last-child {
  border-style: none;
}

.empty-state {
  width: 690rpx;
  padding: 80rpx 0;
  text-align: center;
  color: #888;
  font-size: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-state-sub {
  font-size: 24rpx;
  color: #aaa;
}